# Copy to backend/.env for local development. Never commit real secrets.
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://secureshare:secureshare@localhost:5432/secureshare

# Upload / quarantine
QUARANTINE_DIR=/tmp/secureshare-quarantine

# ClamAV daemon
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Optional security alert webhook
# SECURITY_ALERT_WEBHOOK_URL=https://...

# Azure Blob Storage (auth via Managed Identity / az login — no keys)
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=secureshare-documents
# AZURE_MANAGED_IDENTITY_CLIENT_ID=<user-assigned MI client id>

# Envelope encryption KEK (Azure Key Vault key id, incl. version)
AZURE_KEYVAULT_KEK_ID=https://<vault>.vault.azure.net/keys/secureshare-kek/<version>
# Dev-only alternative (32 random bytes, base64). Refused in production:
# LOCAL_DEV_KEK_B64=
