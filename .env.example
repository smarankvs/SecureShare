# ==============================================================================
# SECURESHARE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# In production, sensitive secrets (Storage Connection String, JWT Secret,
# Database Password) are fetched dynamically from Azure Key Vault.
# These environment variables configure local defaults, credentials, and fallback.

# --- Application Core ---
APP_NAME=SecureShare
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# --- JWT Authentication (Local fallback if Key Vault is disabled) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=e6f83b10c9e78291f092384a2910482937501a39d846e2938173492817293847
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Authentication Mode (Member 2: JWT verification) ---
# local = app-issued HS256 tokens (default, keeps existing /auth endpoints working)
# entra = Microsoft Entra ID RS256 tokens verified against tenant JWKS only
# both  = accept either, dispatched per token shape (use during migration)
AUTH_MODE=local

# --- Microsoft Entra ID (OIDC) ---
# Tenant ID (Directory ID) and the API's Application ID (audience).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional overrides (normally derived from ENTRA_TENANT_ID):
ENTRA_ISSUER=
ENTRA_JWKS_URI=
JWKS_CACHE_TTL_SECONDS=86400
JWKS_REFRESH_COOLDOWN_SECONDS=300
JWKS_HTTP_TIMEOUT_SECONDS=5
JWT_LEEWAY_SECONDS=60

# --- Sharing Policy (Member 2: sharing & revocation) ---
SHARE_SAS_EXPIRY_MINUTES=5
SHARE_MAX_DOWNLOADS_CAP=100
SHARE_MAX_EXPIRY_DAYS=90


# --- Database Configuration (PostgreSQL) ---
# Configured via environment variables to support:
# 1) Local PostgreSQL (Docker / local service)
# 2) Azure Database for PostgreSQL Flexible Server (without code changes)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=secureshare_user
POSTGRES_PASSWORD=SecureShareP@ssw0rd123!
POSTGRES_DB=secureshare_db
# Set to 'require' when connecting to Azure Database for PostgreSQL:
POSTGRES_SSLMODE=
# Optional direct connection URL override (if specified, takes precedence):
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<server>:5432/<dbname>?sslmode=require
# Local SQLite standalone testing fallback:
# DATABASE_URL=sqlite:///./secureshare.db

# --- Existing Azure Key Vault Integration ---
# Enable to dynamically retrieve 'storage-connection-string', 'jwt-secret', and 'database-password'
AZURE_KEYVAULT_ENABLED=false
AZURE_KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/
# Authentication options:
# 1) az login / Managed Identity: Leave the 3 variables below empty
# 2) Service Principal (Optional):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEYVAULT_FALLBACK_TO_ENV=true

# --- Existing Azure Blob Storage Integration ---
AZURE_STORAGE_CONTAINER_NAME=secure-files
# Option A: Connection string (from Azure Portal -> Storage Account -> Security + networking -> Access keys)
AZURE_STORAGE_CONNECTION_STRING=
# Option B: Storage Account Name (uses Azure CLI / Managed Identity credential)
AZURE_STORAGE_ACCOUNT_NAME=
# Local development fallback when running completely offline:
AZURE_STORAGE_USE_LOCAL_FALLBACK=true
LOCAL_STORAGE_DIR=secure_storage_data

# --- File Security Controls ---
MAX_FILE_SIZE_BYTES=26214400 # 25 Megabytes (25 * 1024 * 1024 bytes)

# --- Rate Limiting & CORS ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# --- Antivirus Scanning (ClamAV Integration) ---
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
