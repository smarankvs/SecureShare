# ==============================================================================
# SECURESHARE FRONTEND ENVIRONMENT CONFIGURATION (.env)
# Member 1: Frontend & Identity Integration (Sneha Nayak)
# ==============================================================================

# --- Microsoft Entra ID (formerly Azure AD) App Registration ---
# Application (client) ID of your Entra Single-Page Application (SPA)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID or 'common' / 'organizations'
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Redirect URI configured under Authentication -> Single-Page Application (SPA) in Azure Portal
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Post-logout redirect URI
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# --- Backend API Authorization Scope ---
# The exposed API scope from your backend App Registration in Azure Portal.
# Format: api://<BACKEND_APPLICATION_CLIENT_ID>/<SCOPE_NAME>
# Example: api://aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee/access_as_user
VITE_ENTRA_API_SCOPE=

# --- SecureShare Backend REST API Base URL ---
VITE_API_BASE_URL=http://localhost:8000
